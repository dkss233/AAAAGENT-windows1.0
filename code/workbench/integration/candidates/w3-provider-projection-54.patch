+    typeof value.kind === "string" && PROJECT_MEMORY_KINDS.has(value.kind) &&
+    typeof value.text === "string" && !!value.text.trim() && value.text.length <= 4000 &&
+    (value.branchRef === undefined || value.branchRef === branchRef) &&
+    (value.condition === undefined || typeof value.condition === "string" && !!value.condition.trim()) &&
+    Array.isArray(value.sources) && value.sources.length > 0 &&
