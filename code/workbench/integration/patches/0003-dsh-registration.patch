new file mode 100644
index 00000000..6496115d
--- /dev/null
+++ b/apps/server/src/provider/Layers/DshGatewayResolver.test.ts
@@ -0,0 +1,30 @@
+// @effect-diagnostics nodeBuiltinImport:off -- Temporary fixture files exercise native ownership checks.
+import * as Assert from "node:assert/strict";
+import { mkdtemp, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { it } from "@effect/vitest";
+
+import { resolveDshGatewayUrl } from "./DshGatewayResolver.ts";
+import { DshTransportError } from "./DshHostProtocol.ts";
+
+it("reads only a private, owned launcher file without returning the token in errors", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "t3-dsh-resolver-"));
+  try {
+    const log = join(dir, "web.log");
+    const token = "fixture-secret";
+    const url = `http://127.0.0.1:12345/?token=${token}`;
+    await writeFile(log, `dsh web: ${url}\n`, { mode: 0o600 });
+    Assert.equal(await resolveDshGatewayUrl(log), url);
+    await Assert.rejects(resolveDshGatewayUrl("relative/web.log"), (error: unknown) =>
+      error instanceof DshTransportError && error.code === "unavailable" && !error.message.includes(token));
+    const link = join(dir, "link.log");
+    await symlink(log, link);
+    await Assert.rejects(resolveDshGatewayUrl(link), (error: unknown) =>
+      error instanceof DshTransportError && error.code === "unavailable" && !error.message.includes(token));
+    const publicLog = join(dir, "public.log");
+    await writeFile(publicLog, `dsh web: ${url}\n`, { mode: 0o644 });
+    await Assert.rejects(resolveDshGatewayUrl(publicLog), (error: unknown) =>
+      error instanceof DshTransportError && error.code === "unavailable" && !error.message.includes(token));
+  } finally { await rm(dir, { recursive: true, force: true }); }
+});
diff --git a/apps/server/src/provider/Layers/DshGatewayResolver.ts b/apps/server/src/provider/Layers/DshGatewayResolver.ts
new file mode 100644
index 00000000..45ce157e
--- /dev/null
+++ b/apps/server/src/provider/Layers/DshGatewayResolver.ts
@@ -0,0 +1,31 @@
+// @effect-diagnostics nodeBuiltinImport:off -- A bounded native read of the private Host launch log.
+import { constants } from "node:fs";
+import { open } from "node:fs/promises";
+import { isAbsolute } from "node:path";
+
+import { DshTransportError } from "./DshHostProtocol.ts";
+
+/** Keep the existing Host launch URL inside the server process. */
+export async function resolveDshGatewayUrl(logPath: string | undefined): Promise<string> {
+  if (!logPath || !isAbsolute(logPath) || logPath.includes("\0") || process.getuid?.() === undefined) {
+    throw new DshTransportError("unavailable");
+  }
+  try {
+    const handle = await open(logPath, constants.O_RDONLY | constants.O_NOFOLLOW);
+    try {
+      const info = await handle.stat();
+      if (!info.isFile() || info.uid !== process.getuid() || (info.mode & 0o077) !== 0) {
+        throw new DshTransportError("unavailable");
+      }
+      const bytes = Buffer.alloc(8192);
+      const { bytesRead } = await handle.read(bytes, 0, bytes.length, 0);
+      const match = bytes.subarray(0, bytesRead).toString("utf8")
+        .match(/dsh web:\s+(http:\/\/127\.0\.0\.1:\d+\/\?token=[^\s]+)/);
+      if (!match?.[1]) throw new DshTransportError("unavailable");
+      return match[1];
+    } finally { await handle.close(); }
+  } catch {
+    // Native filesystem errors may include the private path; never return it.
+    throw new DshTransportError("unavailable");
+  }
+}
