+function verifyStrictOpenResponse<T>(
+  response: T,
+  runtimeMode: RuntimeMode,
+  cwd: string,
+  method: "thread/start" | "thread/resume",
+): Effect.Effect<T, CodexErrors.CodexAppServerRequestError> {
+  if (runtimeMode !== "approval-required") return Effect.succeed(response);
+  const value = response as Record<string, unknown> | null;
+  const sandbox = value?.sandbox as Record<string, unknown> | undefined;
+  if (value?.approvalPolicy !== "untrusted" || value.approvalsReviewer !== "user" ||
+      value.cwd !== cwd || sandbox?.type !== "readOnly" || sandbox.networkAccess === true) {
+    return Effect.fail(CodexErrors.CodexAppServerRequestError.invalidParams(
+      "Strict Codex approval policy was not active", undefined, { method },
+    ));
+  }
+  return Effect.succeed(response);
+}
