+const PROJECT_MEMORY_KEYS = new Set([
+  "status", "projectId", "id", "version", "kind", "text", "branchRef", "condition", "sources",
+]);
+const PROJECT_SOURCE_KEYS = new Set([
+  "taskId", "nativeTurnId", "terminalEventId", "artifactRef", "userInputId", "recordedAt",
+]);
+const PROJECT_SOURCE_REFS = [
+  "taskId", "nativeTurnId", "terminalEventId", "artifactRef", "userInputId",
+] as const;
+const PROJECT_MEMORY_KINDS = new Set(["decision", "constraint", "fact", "open_question"]);
+const encodeProjectMemoryDigestInput = Schema.encodeSync(Schema.fromJsonString(Schema.Unknown));
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function validProjectMemorySource(value: unknown): boolean {
+  if (!isRecord(value) || Object.keys(value).some((key) => !PROJECT_SOURCE_KEYS.has(key)) ||
+      typeof value.recordedAt !== "string" || !Number.isFinite(Date.parse(value.recordedAt))) {
+    return false;
+  }
+  return PROJECT_SOURCE_REFS.every((key) => value[key] === undefined ||
+      typeof value[key] === "string" && value[key].trim().length > 0);
+}
+
+function validProjectMemoryPayload(value: unknown, branchRef: string | null): value is Record<string, unknown> {
+  return isRecord(value) && Object.keys(value).every((key) => PROJECT_MEMORY_KEYS.has(key)) &&
+    value.status === "accepted" && typeof value.projectId === "string" && !!value.projectId.trim() &&
+    typeof value.id === "string" && !!value.id.trim() &&
+    Number.isSafeInteger(value.version) && Number(value.version) > 0 &&
+    typeof value.kind === "string" && PROJECT_MEMORY_KINDS.has(value.kind) &&
+    typeof value.text === "string" && !!value.text.trim() && value.text.length <= 4000 &&
+    (value.branchRef === undefined || value.branchRef === branchRef) &&
+    (value.condition === undefined || typeof value.condition === "string" && !!value.condition.trim()) &&
+    Array.isArray(value.sources) && value.sources.length > 0 &&
+    value.sources.every(validProjectMemorySource);
+}
+
+function projectMemoryReferences(sidecar: ProviderOnlyProjectContext): string {
+  return sidecar.context.records.map((record) => formatComposerContextReference({
+    kind: record.kind, contextId: record.contextId, label: record.label,
+  })).join("\n");
+}
