+/** Keep exact selections addressable when multiple roots contain the same Skill name. */
+export function dedupeProviderSkillsByIdentity(
+  skills: ReadonlyArray<ServerProviderSkill>,
+): ServerProviderSkill[] {
+  const seen = new Set<string>();
+  return skills.filter((skill) => {
+    const key = JSON.stringify([skill.name, skill.path]);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+}
