+      { ...forwarded, id: "not-app", namespace: "other" }, { ...forwarded, id: "not-send", name: "read_thread" },
+      { ...forwarded, id: "malformed", output: "private tool output" }, forwarded, { type: "agentMessage", id: "reply", text: "answer" },
