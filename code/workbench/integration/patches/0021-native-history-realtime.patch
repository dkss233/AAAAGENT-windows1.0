+      worker = runtime.runFork(Effect.flatMap(makeNativeSessionSync, work => work));
+      await until(async () => (await read()).messages.length === 2);
+      expect(reads).toBe(1); await pause(5200); expect(reads).toBe(1);
+      generation = 2; notify!(); notify!();
