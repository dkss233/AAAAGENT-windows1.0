+++ b/apps/server/src/provider/Layers/DshHostProtocol.test.ts
@@ -0,0 +1,74 @@
+import * as Assert from "node:assert/strict";
+import { it } from "@effect/vitest";
+
+import { DshTransportError, HttpDshSessionRpc, makeDshHostProtocol, type DshSessionRpc } from "./DshHostProtocol.ts";
+
+const events = [
+  { seq: 1, type: "turn/start", data: { turn: 7 } },
+  { seq: 2, type: "user/message", data: { source: { kind: "user", rpcId: "request-1" } } },
+  { seq: 3, type: "assistant/message", data: { turn: 7, message: { content: [{ type: "text", text: "private fixture" }] } } },
+  { seq: 4, type: "turn/end", data: { turn: 7, reason: { kind: "completed" } } },
+];
+
+it("reads the exact native turn while keeping model selection closed", async () => {
+  const calls: string[] = [];
+  const rpc: DshSessionRpc = { call: async (method) => {
+    calls.push(method);
+    if (method === "session/list") return { items: [{ sessionId: "session-1", cwd: "/fixture/project", running: false,
+      projections: { asOfSeq: 4, values: {} } }] };
+    if (method === "session/page") return { records: events.map(event => ({ type: "event", event })), hasMore: false };
+    if (method === "session/prompt") return { accepted: true };
+    if (method === "session/create") return { sessionId: "session-1", agentPreset: "preset-1" };
+    throw new Error("unexpected method");
+  } };
+  const host = makeDshHostProtocol(rpc);
+  const description = await host.describe();
+  Assert.equal(description.version, null);
+  Assert.deepEqual(description.models, []);
+  Assert.equal(await host.hasSession("session-1", "/fixture/project"), true);
+  await host.create("session-1", "/fixture/project", "preset-1");
+  await host.prompt("session-1", "request-1", "synthetic text");
+  Assert.deepEqual(await host.observe("session-1", "request-1"), {
+    status: "completed", nativeTurn: 7, terminalSeq: 4,
+  });
+  Assert.ok(!JSON.stringify(description).includes("private fixture"));
+  Assert.equal(calls.filter(call => call === "session/prompt").length, 1);
+});
+
+it("does not promote a broken or foreign native history to completion", async () => {
+  const rpc = (source: typeof events): DshSessionRpc => ({ call: async (method) => {
+    if (method === "session/list") return { items: [{ sessionId: "session-1", cwd: "/fixture/project", running: false,
+      projections: { asOfSeq: 4, values: {} } }] };
+    if (method === "session/page") return { records: source.map(event => ({ type: "event", event })), hasMore: false };
+    throw new Error("read only fixture");
+  } });
+  Assert.equal((await makeDshHostProtocol(rpc([events[0]!, events[2]!, events[3]!])).observe("session-1", "request-1")).status,
+    "unknown");
+  const foreign = [events[0]!, { seq: 2, type: "user/message", data: { source: { kind: "user", rpcId: "other" } } },
+    { ...events[1]!, seq: 3 }, events[3]!];
+  Assert.equal((await makeDshHostProtocol(rpc(foreign)).observe("session-1", "request-1")).status, "unknown");
+});
+
+it("restricts the launcher exchange to loopback and redacts transport errors", async () => {
+  const calls: string[] = [];
+  const fakeFetch = (async (input: URL | Request, init?: RequestInit): Promise<Response> => {
+    if (calls.length === 0) {
+      calls.push("launcher");
+      Assert.equal(init?.redirect, "manual");
+      return new Response(null, { status: 303, headers: { location: "/", "set-cookie": "sid=fixture-cookie; Path=/" } });
+    }
+    calls.push("rpc");
+    Assert.equal(String(input), "http://127.0.0.1:12345/api/session/list");
+    const request = JSON.parse(String(init?.body)) as { rpcId: string; method: string };
+    Assert.equal(request.method, "session/list");
+    return new Response(JSON.stringify({ type: "server-response", rpcId: request.rpcId,
+      result: { ok: true, value: { items: [] } } }), { status: 200 });
+  }) as typeof fetch;
+  const rpc = new HttpDshSessionRpc(async () => "http://127.0.0.1:12345/?token=fixture-secret", fakeFetch);
+  Assert.deepEqual(await rpc.call("session/list", { _request: {} }), { items: [] });
+  Assert.deepEqual(calls, ["launcher", "rpc"]);
+  const hostile = new HttpDshSessionRpc(async () => "https://example.com/?token=fixture-secret", fakeFetch);
+  await Assert.rejects(hostile.call("session/list", {}), (error: unknown) =>
+    error instanceof DshTransportError && error.code === "authentication_required" && !error.message.includes("fixture-secret"));
+  Assert.equal(calls.length, 2);
+});
diff --git a/apps/server/src/provider/Layers/DshHostProtocol.ts b/apps/server/src/provider/Layers/DshHostProtocol.ts
new file mode 100644
index 00000000..d7c483c5
--- /dev/null
+++ b/apps/server/src/provider/Layers/DshHostProtocol.ts
@@ -0,0 +1,198 @@
+// @effect-diagnostics globalTimers:off cryptoRandomUUID:off -- This bounded native HTTP client owns its deadline and wire request IDs.
+import type { DshHostPort } from "./DshAdapter.ts";
+
+type DshMethod = "session/list" | "session/page" | "session/create" | "session/prompt";
+export interface DshSessionRpc { call(method: DshMethod, args: object): Promise<unknown> }
+
+export class DshTransportError extends Error {
+  readonly code: "unavailable" | "authentication_required" | "incompatible";
+  constructor(code: DshTransportError["code"]) { super(code); this.code = code; }
+}
+
+const record = (value: unknown): Record<string, unknown> | null =>
+  value !== null && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : null;
+const integer = (value: unknown): value is number => Number.isSafeInteger(value) && (value as number) >= 0;
+const nativeId = (value: string): boolean => /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/.test(value);
+
+/** I supplies the resolver inside the T3 server; the URL and cookie never leave this transport. */
+export class HttpDshSessionRpc implements DshSessionRpc {
+  private readonly resolveGatewayUrl: () => Promise<string>;
+  private readonly fetcher: typeof fetch;
+  private readonly timeoutMs: number;
+  constructor(resolveGatewayUrl: () => Promise<string>, fetcher: typeof fetch = fetch, timeoutMs = 5000) {
+    this.resolveGatewayUrl = resolveGatewayUrl;
+    this.fetcher = fetcher;
+    this.timeoutMs = timeoutMs;
+    if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1) throw new DshTransportError("incompatible");
+  }
+
+  private async gateway(): Promise<URL> {
+    try {
+      const url = new URL(await this.resolveGatewayUrl());
+      if (url.protocol !== "http:" || url.hostname !== "127.0.0.1" || !url.port || url.pathname !== "/" ||
+          url.hash || url.username || url.password || url.searchParams.getAll("token").length !== 1 ||
+          !url.searchParams.get("token") || [...url.searchParams.keys()].some(key => key !== "token")) {
+        throw new DshTransportError("authentication_required");
+      }
+      return url;
+    } catch { throw new DshTransportError("authentication_required"); }
+  }
+
+  async call(method: DshMethod, args: object): Promise<unknown> {
+    if (!["session/list", "session/page", "session/create", "session/prompt"].includes(method)) {
+      throw new DshTransportError("incompatible");
+    }
+    const abort = new AbortController();
+    const timer = setTimeout(() => abort.abort(), this.timeoutMs);
+    try {
+      const gateway = await this.gateway();
+      const exchange = await this.fetcher(gateway, { redirect: "manual", signal: abort.signal });
+      const cookie = exchange.headers.get("set-cookie")?.split(";")[0];
+      await exchange.body?.cancel();
+      if (exchange.status !== 303 || !["/", "./"].includes(exchange.headers.get("location") ?? "") || !cookie ||
+          !/^[A-Za-z0-9_-]+=[A-Za-z0-9_.-]+$/.test(cookie)) throw new DshTransportError("authentication_required");
+      const rpcId = crypto.randomUUID();
+      const response = await this.fetcher(`${gateway.origin}/api/${method}`, {
+        method: "POST", redirect: "manual", signal: abort.signal,
+        headers: { Cookie: cookie, Origin: gateway.origin, "Content-Type": "application/json" },
+        body: JSON.stringify({ type: "client-request", rpcId, method, payload: { args } }),
+      });
+      if (response.status === 401 || response.status === 403) throw new DshTransportError("authentication_required");
+      if (!response.ok || !response.body) throw new DshTransportError("unavailable");
+      const reader = response.body.getReader();
+      const chunks: Uint8Array[] = [];
+      let bytes = 0;
+      while (true) {
+        const part = await reader.read();
+        if (part.done) break;
+        bytes += part.value.byteLength;
+        if (bytes > 4 * 1024 * 1024) { await reader.cancel(); throw new DshTransportError("incompatible"); }
+        chunks.push(part.value);
+      }
+      const body = JSON.parse(Buffer.concat(chunks).toString("utf8")) as unknown;
+      const result = record(body);
+      const payload = record(result?.result);
+      if (result?.type !== "server-response" || result.rpcId !== rpcId || payload?.ok !== true) {
+        throw new DshTransportError("incompatible");
+      }
+      return payload.value;
+    } catch (error) {
+      // Native and fetch errors can contain the bearer URL or private task content.
+      if (error instanceof DshTransportError) throw error;
+      throw new DshTransportError("unavailable");
+    } finally { clearTimeout(timer); }
+  }
+}
+
+interface NativeEvent { readonly seq: number; readonly type: string; readonly data: unknown }
+interface SessionRow { readonly sessionId: string; readonly running: boolean; readonly cwd?: string;
+  readonly parentSessionId?: string; readonly origin?: string;
+  readonly projections?: { readonly asOfSeq: number; readonly values?: Record<string, unknown> } }
+
+async function listRows(rpc: DshSessionRpc): Promise<SessionRow[]> {
+  const value = record(await rpc.call("session/list", { _request: {} }));
+  if (!Array.isArray(value?.items)) throw new DshTransportError("incompatible");
+  return value.items as SessionRow[];
+}
+
+/** Matches the installed 0.1.5-rc.2 session controller, with unknown on ambiguous history. */
+export function makeDshHostProtocol(rpc: DshSessionRpc): DshHostPort {
+  return {
+    describe: async () => {
+      await listRows(rpc);
+      // Native selectModel also saves the global default; do not advertise actionable models.
+      return { installed: true, authenticated: true, version: null, models: [] };
+    },
+    hasSession: async (sessionId, cwd) => {
+      if (!nativeId(sessionId) || !cwd.startsWith("/")) throw new DshTransportError("incompatible");
+      const matches = (await listRows(rpc)).filter(row => row.sessionId === sessionId);
+      if (matches.length === 0) return false;
+      if (matches.length !== 1 || matches[0]?.cwd !== cwd || matches[0]?.parentSessionId || matches[0]?.origin === "subagent") {
+        throw new DshTransportError("incompatible");
+      }
+      return true;
+    },
+    create: async (sessionId, cwd, preset) => {
+      if (!nativeId(sessionId) || !cwd.startsWith("/") || /[\0\r\n]/.test(cwd) || !preset.trim()) {
+        throw new DshTransportError("incompatible");
+      }
+      const value = record(await rpc.call("session/create", { request: { sessionId, cwd, agentPreset: preset } }));
+      if (value?.sessionId !== sessionId || value.agentPreset !== preset) throw new DshTransportError("incompatible");
+    },
+    prompt: async (sessionId, requestId, text) => {
+      if (!nativeId(sessionId) || !nativeId(requestId) || !text.trim()) throw new DshTransportError("incompatible");
+      const value = record(await rpc.call("session/prompt", { request: { sessionId, requestId, mode: "queue",
+        content: [{ type: "text", text }] } }));
+      if (value?.accepted !== true) throw new DshTransportError("incompatible");
+    },
+    observe: async (sessionId, requestId) => readExactPrompt(rpc, sessionId, requestId),
+  };
+}
+
+async function readExactPrompt(rpc: DshSessionRpc, sessionId: string, requestId: string): ReturnType<DshHostPort["observe"]> {
+  const unknown = { status: "unknown" as const };
+  if (!nativeId(sessionId) || !nativeId(requestId)) return unknown;
+  try {
+    const matches = (await listRows(rpc)).filter(row => row.sessionId === sessionId);
+    if (matches.length !== 1) return unknown;
+    const row = matches[0]!;
+    const throughSeq = row.projections?.asOfSeq;
+    if (typeof row.running !== "boolean" || row.parentSessionId || row.origin === "subagent" || !integer(throughSeq)) return unknown;
+    const inbox = record(row.projections?.values?.inbox);
+    const queued = ["next-turn", "next-step"].some(key => Array.isArray(inbox?.[key]) &&
+      (inbox[key] as unknown[]).some(item => record(record(item)?.source)?.rpcId === requestId));
+    const events: NativeEvent[] = [];
+    let beforeSeq: number | undefined;
+    let exhausted = false;
+    for (let pageIndex = 0; pageIndex < 16; pageIndex++) {
+      const page = record(await rpc.call("session/page", { request: { address: { kind: "session", sessionId }, throughSeq,
+        maxMessages: 6, ...(beforeSeq === undefined ? {} : { beforeSeq }) } }));
+      const records = page?.records;
+      if (!Array.isArray(records) || typeof page?.hasMore !== "boolean" || records.length === 0) return unknown;
+      const current = records.map(item => record(record(item)?.event)).filter((item): item is Record<string, unknown> => item !== null);
+      if (current.length !== records.length || current.some((item, index) => !integer(item.seq) || (item.seq as number) > throughSeq ||
+          (beforeSeq !== undefined && (item.seq as number) >= beforeSeq) ||
+          (index > 0 && (item.seq as number) !== (current[index - 1]?.seq as number) + 1))) return unknown;
+      if (current.at(-1)?.seq !== (beforeSeq ?? throughSeq + 1) - 1) return unknown;
+      for (const item of current) events.push({ seq: item.seq as number, type: item.type as string, data: item.data });
+      if (!page.hasMore) { exhausted = true; break; }
+      beforeSeq = current[0]?.seq as number;
+    }
+    let activeTurn: number | null = null;
+    let boundTurn: number | null = null;
+    let end: { seq: number; reason: string } | null = null;
+    let duplicate = false;
+    const foreignTurns = new Set<number>();
+    const pending = new Set<string>();
+    for (const event of events.sort((a, b) => a.seq - b.seq)) {
+      const data = record(event.data);
+      const turn = data?.turn;
+      if (event.type === "turn/start" && integer(turn)) activeTurn = turn;
+      if (event.type === "user/message" && activeTurn !== null) {
+        const source = record(data?.source);
+        if (source?.kind === "user" && source.rpcId === requestId) {
+          if (boundTurn !== null) duplicate = true;
+          boundTurn = activeTurn;
+        } else foreignTurns.add(activeTurn);
+      }
+      if (boundTurn !== null && activeTurn === boundTurn) {
+        if (event.type === "approval/asked" && typeof data?.id === "string") pending.add(data.id);
+        if (event.type === "approval/decided" && typeof data?.id === "string") pending.delete(data.id);
+      }
+      if (event.type === "turn/end" && integer(turn)) {
+        if (boundTurn === turn) end = { seq: event.seq, reason: String(record(data?.reason)?.kind ?? "") };
+        if (activeTurn === turn) activeTurn = null;
+      }
+    }
+    if (duplicate || boundTurn !== null && foreignTurns.has(boundTurn) || queued && end) return unknown;
+    if (boundTurn === null) return queued ? { status: "queued" } : unknown;
+    if (end) {
+      const status = end.reason === "completed" && pending.size === 0 ? "completed" :
+        ["aborted", "interrupted"].includes(end.reason) ? "cancelled" :
+        ["error", "blocked", "max-tokens"].includes(end.reason) ? "failed" : "unknown";
+      return status === "unknown" ? unknown : { status, nativeTurn: boundTurn, terminalSeq: end.seq };
+    }
+    if (!row.running || activeTurn !== boundTurn || !exhausted) return unknown;
+    return { status: pending.size ? "waiting_approval" : "running", nativeTurn: boundTurn };
+  } catch { return unknown; }
+}
